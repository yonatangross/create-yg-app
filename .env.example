# =============================================================================
# YG Starter - Environment Configuration
# =============================================================================
# Copy this file to .env and update values as needed.
# Run ./init.sh "Your Project Name" to generate secrets automatically.
# NEVER commit your actual .env file!
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Provider API Keys (at least one required)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=

# -----------------------------------------------------------------------------
# PostgreSQL Database (Main Application)
# -----------------------------------------------------------------------------
POSTGRES_USER=dev
POSTGRES_PASSWORD=GENERATE_ME_POSTGRES
POSTGRES_DB=yg-starter

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
REDIS_PASSWORD=GENERATE_ME_REDIS

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
JWT_SECRET=GENERATE_ME_JWT
JWT_REFRESH_SECRET=GENERATE_ME_JWT_REFRESH

# -----------------------------------------------------------------------------
# Langfuse Observability (Self-Hosted)
# -----------------------------------------------------------------------------
LANGFUSE_POSTGRES_USER=langfuse
LANGFUSE_POSTGRES_PASSWORD=GENERATE_ME_LANGFUSE_PG
LANGFUSE_POSTGRES_DB=langfuse

CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=GENERATE_ME_CLICKHOUSE

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=GENERATE_ME_MINIO

NEXTAUTH_SECRET=GENERATE_ME_NEXTAUTH
NEXTAUTH_SALT=GENERATE_ME_SALT
LANGFUSE_ENCRYPTION_KEY=GENERATE_ME_ENCRYPTION
LANGFUSE_INIT_USER_PASSWORD=admin123

LANGFUSE_REDIS_PASSWORD=GENERATE_ME_LANGFUSE_REDIS

# =============================================================================
# Notes:
# - Run ./init.sh "Your Project Name" to generate all GENERATE_ME values
# - Add at least one LLM API key (OpenAI, Anthropic, or Google)
# - For production, rotate all secrets and use a secrets manager
# =============================================================================
