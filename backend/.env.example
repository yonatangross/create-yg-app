# =============================================================================
# YG Starter Backend - Environment Configuration
# =============================================================================

# Environment
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# Server
HOST=0.0.0.0
PORT=8600

# Database
DATABASE_URL=postgresql+asyncpg://dev:password@localhost:5447/yg-starter

# Redis
REDIS_URL=redis://:password@localhost:6390

# LLM Configuration (at least one API key required)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=

# Default model (auto-detects provider from model name)
LLM_MODEL=gpt-4o-mini

# Langfuse Observability
LANGFUSE_ENABLED=true
LANGFUSE_HOST=http://localhost:3010
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
