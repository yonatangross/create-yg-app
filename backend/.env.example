# =============================================================================
# YG Starter - Single Environment Configuration (SINGLE SOURCE OF TRUTH)
# =============================================================================
# Copy this file to backend/.env and update values as needed.
# Run ./init.sh "Your Project Name" to generate secrets automatically.
# NEVER commit your actual .env file!
#
# This file is used by:
# - Backend application (via backend/.env)
# - Docker Compose (via --env-file backend/.env flag)
# - All infrastructure services (Postgres, Redis, Langfuse stack)
# =============================================================================

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# Server
HOST=0.0.0.0
PORT=8600

# -----------------------------------------------------------------------------
# PostgreSQL Database (Main Application)
# -----------------------------------------------------------------------------
POSTGRES_USER=dev
POSTGRES_PASSWORD=GENERATE_ME_POSTGRES
POSTGRES_DB=yg-starter

# Database URL for backend (localhost for local dev, postgres for docker)
DATABASE_URL=postgresql+asyncpg://dev:GENERATE_ME_POSTGRES@localhost:5447/yg-starter

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
REDIS_PASSWORD=GENERATE_ME_REDIS

# Redis URL for backend (localhost for local dev, redis for docker)
REDIS_URL=redis://:GENERATE_ME_REDIS@localhost:6390

# -----------------------------------------------------------------------------
# LLM Provider API Keys (at least one required)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=

# Default model (auto-detects provider from model name)
LLM_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Langfuse Observability (Self-Hosted)
# -----------------------------------------------------------------------------
# Langfuse Database
LANGFUSE_POSTGRES_USER=langfuse
LANGFUSE_POSTGRES_PASSWORD=GENERATE_ME_LANGFUSE_PG
LANGFUSE_POSTGRES_DB=langfuse

# ClickHouse (for Langfuse analytics)
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=GENERATE_ME_CLICKHOUSE

# MinIO (S3-compatible storage for Langfuse)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=GENERATE_ME_MINIO

# Langfuse Auth & Encryption
NEXTAUTH_SECRET=GENERATE_ME_NEXTAUTH
NEXTAUTH_SALT=GENERATE_ME_SALT
LANGFUSE_ENCRYPTION_KEY=GENERATE_ME_ENCRYPTION
LANGFUSE_INIT_USER_PASSWORD=admin123

# Langfuse Redis
LANGFUSE_REDIS_PASSWORD=GENERATE_ME_LANGFUSE_REDIS

# Langfuse API Keys (Backend Integration - Generated via Langfuse UI)
LANGFUSE_ENABLED=true
LANGFUSE_HOST=http://localhost:3010
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# =============================================================================
# Setup Instructions:
# =============================================================================
# 1. Run ./init.sh "Your Project Name" to auto-generate all GENERATE_ME secrets
# 2. Add at least one LLM API key (OpenAI, Anthropic, Google, or X.AI)
# 3. After first startup, get Langfuse API keys from http://localhost:3010
# 4. Run: make dev
#
# For production:
# - Rotate all secrets
# - Use a secrets manager (AWS Secrets Manager, HashiCorp Vault, etc.)
# - Set ENVIRONMENT=production
# - Set LOG_LEVEL=INFO
# =============================================================================
